 "bugFixes": [],
 "skills": [
  {
   "key": "passive",
   "label": "被动",
   "name": "影忍法！灭魂劫",
   "desc": "当劫对一名低于50%生命值的敌人进行攻击时，他会造成额外的(5%-10%【随等级提升】)最大生命值的魔法伤害。敌方英雄在10秒里只会受到一次此效果。 这个技能对野怪造成75%伤害，对史诗级野怪最多造成175伤害。",
   "icon": "assets/img/skills/ZedPassive_shadowninja_P.png"
  },
  {
   "key": "q",
   "label": "Q",
   "name": "影奥义！诸刃",
   "desc": "劫和他的影分身一起将他们的手里剑向前方掷出，每一枚手里剑都会对命中的第一个敌人造成91=(【80/120/160/200/240】 +100% 【额外攻击力】 )物理伤害，并对之后的每个敌人造成(【48/72/96/120/144】 +60%【额外攻击力】)物理伤害。",
   "icon": "assets/img/skills/Zedq_ZedQ.png"
  },
  {
   "key": "w",
   "label": "W",
   "name": "影奥义！分身",
   "desc": "被动：当劫和他的影分身用相同技能击中一名敌方英雄时，劫会回复【30/35/40/45/50】能量。 主动：劫的影分身向前突进，并在一个地方维持5秒。再次施放这个技能会让劫与这个影分身互换位置。 每次施放技能只会回复一次能量。",
   "icon": "assets/img/skills/Zedw_ZedW.png"
  },
  {
   "key": "e",
   "label": "E",
   "name": "影奥义！鬼斩",
   "desc": "劫和他的影分身进行斩击，对附近的敌人造成(【70/92.5/115/137.5/160】 +70%【额外攻击力】)物理伤害。 每个被劫的斩击所命中的敌方英雄都会使影奥义!分身的冷却时间减少3秒。 被影分身的斩击所击中的敌人，将会被减速【20%/25%/30%/35%/40%】，持续1.5秒。被多个斩击同时击中的敌人，将会被减速【30%/37.5%/45%/45%/60%】，但不会受到额外伤害。",
   "icon": "assets/img/skills/Zede_ZedE.png"
  },
  {
   "key": "r",
   "label": "R",
   "name": "禁奥义！瞬狱影杀阵",
   "desc": "劫变得不可被选取，突进向一位敌方英雄，并将其标记。3秒后，标记会触发，对目标 造成(100%【攻击力】)物理伤害，加上印记激活期间劫所造成的伤害总和的【25%/40%/55%】。 突进会留下一个影分身在身后，持续7.5秒。再次施放此技能会使劫与这个影分身互换位 置。 不可被选取的单位不会受到敌人的攻击或技能的影响，除非在进入此状态前已被它们影响。 影分身会在再次施放的时间窗口结束后存留额外的1.5秒。",
   "icon": "assets/img/skills/Zedr_ZedR.png"
  }
 ],
