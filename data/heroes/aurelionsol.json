{"slug":"aurelionsol","name":"奥瑞利安·索尔","title":"铸星龙王","icon":"assets/zhishi/champions/aurelionsol.374839ea5a4d.webp","roles":["Mage"],"rank":{"rank":67,"tier":"B","win":50.29,"pick":10.96,"sample":1649863,"blue":52.64,"red":47.95},"abil":[{"k":"Q","n":"星河冲荡","d":"奥瑞利安·索尔引导他的龙息若干秒，伤害首个命中的敌人并对附近的敌人们造成削减过的溅射伤害。龙息在一个敌人身上每直接引导一秒就会造成额外伤害，这个伤害可通过已收集的【星尘】来提升。如果目标是一名英雄，那么这个技能还会收集【星尘】。","ic":"assets/zhishi/resources/abilities/aurelionsol-q.f8feb2d0d2d7.webp"},{"k":"E","n":"星芒凝汇","d":"奥瑞利安·索尔召唤一个黑洞，对敌人们造成伤害并缓慢地将他们拉拽向黑洞的中心。每有一名敌人在黑洞中阵亡，以及一名敌方英雄在黑洞中每被困住一秒，这个技能都会提供【星尘】。黑洞的中心会处决低于一定百分比最大生命值的敌人。【星尘】会提升【星芒凝汇】的区域以及处决阈值。","ic":"assets/zhishi/resources/abilities/aurelionsol-e.0d07d64b03a7.webp"},{"k":"W","n":"星穹流丽","d":"奥瑞利安 · 索尔沿着目标方向飞越地形。在这个状态下，他可以施放其它技能。飞行期间，星河冲荡没有冷却时间，也没有最长蓄力时间，并且造成的伤害会提升。<br><br>如果有敌方英雄因为奥瑞利安 · 索尔近期造成的伤害阵亡，星穹流丽的冷却时间会缩短。<br><br>星尘会提升星穹流丽的最大飞行距离。","ic":"assets/zhishi/resources/abilities/aurelionsol-w.008db2105ee6.webp"}],"order":"Q>E>W","spells":[{"n":"闪现","ic":"assets/zhishi/resources/summoner-spells/4.9084bda9d319.webp"},{"n":"幽灵疾步","ic":"assets/zhishi/resources/summoner-spells/6.d7ffb021657e.webp"}],"builds":[{"k":"ap","n":"法术流","win":50.44,"pick":89.14,"sample":1324417,"low":false,"start":[{"i":3802,"n":"遗失的章节","ic":"assets/zhishi/resources/items/3802.cbfa17bc3d75.webp","w":null,"p":null,"s":null,"pr":null}],"core":[{"i":2503,"n":"黯炎火炬","ic":"assets/zhishi/resources/items/2503.b73e56ff8ac4.webp","w":52.91,"p":23.61,"s":312636,"pr":2800},{"i":3116,"n":"瑞莱的冰晶节杖","ic":"assets/zhishi/resources/items/3116.1be693c032a6.webp","w":52.91,"p":23.61,"s":312636,"pr":2600},{"i":6653,"n":"兰德里的折磨","ic":"assets/zhishi/resources/items/6653.cbc7718a88cc.webp","w":52.91,"p":23.61,"s":312636,"pr":3000}],"six":[{"i":2503,"n":"黯炎火炬","ic":"assets/zhishi/resources/items/2503.b73e56ff8ac4.webp","w":52.91,"p":23.61,"s":312636,"pr":2800},{"i":3116,"n":"瑞莱的冰晶节杖","ic":"assets/zhishi/resources/items/3116.1be693c032a6.webp","w":52.91,"p":23.61,"s":312636,"pr":2600},{"i":6653,"n":"兰德里的折磨","ic"