 "skills": [
  {
   "key": "passive",
   "label": "被动",
   "name": "艾克塞之怒",
   "desc": "雷克塞的攻击生成25怒气，技能则生成25怒气。 在位于地下时，她会消耗怒气，在3秒里持续回复至多(9-20%【生命值】【基于等级】)生命值。 雷克塞在满额生命值时不会消耗怒气。 雷克塞在不生成任何怒气的5秒后会每秒失去20怒气 雷克塞对小兵的攻击生成16%怒气",
   "icon": "assets/img/skills/RekSaiPassive_RekSai_Passive.png"
  },
  {
   "key": "q",
   "label": "Q",
   "name": "女王之怒 / 猎物搜寻",
   "desc": "位于地表：雷克塞在3秒内的下3次普攻会获得35%攻击速度并对附近的敌人造成额外的(【30%/35%/40%/45%/50%】【攻击力】)物理伤害。攻击会刷新这个技能的持续时长。 位于地下：雷克塞发射一团充满虚空能量的土壤，在命中第一个敌人后爆炸，在一个小区域内造成(【50/80/110/140/170】+25%【额外攻击力】 +70%【法术强度】)魔法伤害。它还会使被命中的非潜行敌人显形5秒。如果命中了一位英雄，它还会生成25怒气。 额外伤害可在主要目标上产生暴击。",
   "icon": "assets/img/skills/RekSaiq_RekSaiQ.png"
  },
  {
   "key": "w",
   "label": "W",
   "name": "遁地 / 破土而出",
   "desc": "位于地表：雷克塞遁入地下，获得全新的一套技能但不能攻击。她获得【5/10/15/20/25】移动速度，视野距离被降低65%，并且附近不可见的敌人在移动时会将其位置显形给雷克塞和她的友军。 位于地下：雷克塞破土而出，对所有附近的敌人造成(【30/55/80/105/130】+80%【法术强度】)魔法伤害，并对她的主要目标，以及附近的英雄和大型野怪造成1秒击飞。每个敌人在11秒里只会被这个技能击飞一次。",
   "icon": "assets/img/skills/RekSaiw_RekSaiW.png"
  },
  {
   "key": "e",
   "label": "E",
   "name": "狂野之噬 / 挖掘隧道",
   "desc": "位于地表：雷克塞撕咬一个目标，造成(80/108/136/164/192+64%【额外攻击力】)物理伤害。在满额怒气时，这次撕咬会转而造成(100/135/170/205/240+80%【额外攻击力】)真实伤害。 位于地下：雷克塞向前掘地，留下两个彼此相连且持续10分钟的隧道入口。雷克塞可以点击任一入口来遁行到另一入口，并且每条隧道在使用后会有2秒的冷却时间。雷克塞至多可以同时拥有8条隧道。",
   "icon": "assets/img/skills/RekSaie_RekSaiE.png"
  },
  {
   "key": "r",
   "label": "R",
   "name": "虚空猛冲",
   "desc": "雷克塞将一个之前的5秒内被她造成过伤害的敌人选为目标，随后遁入地下，进入不可选状态。片刻之后，她会不可阻挡地跃向目标，造成(【150/250/350】+100%【额外攻击力】)加上【15%/20%/25%】最大生命值的物理伤害。",
   "icon": "assets/img/skills/RekSair_RekSaiR.png"
  }
 ],
