 "skills": [
  {
   "key": "passive",
   "label": "被动",
   "name": "一触即发",
   "desc": "每过12秒，吉格斯的下次普通攻击就会造成额外的(20-160【随等级提升】+50%【法术强度】)魔法伤害。这个技能会对建筑造成(35-280【随等级提升】+87.5%【法术强度】)伤害。 吉格斯每施放一次技能，这个效果的冷却时间就会缩短(4-6【随等级提升】)秒。",
   "icon": "assets/img/skills/ZiggsPassive_ZiggsPassiveReady.png"
  },
  {
   "key": "q",
   "label": "Q",
   "name": "弹跳炸弹",
   "desc": "吉格斯扔出一个会弹跳的炸弹，对敌人造成(【80/130/180/230/280】+【60%/65%/70%/75%/80%】【法术强度】)魔法伤害。",
   "icon": "assets/img/skills/Ziggsq_ZiggsQ.png"
  },
  {
   "key": "w",
   "label": "W",
   "name": "定点爆破",
   "desc": "吉格斯扔出一个炸药包，会在4秒后或者在再次施放该技能后爆炸。爆炸会对敌人造成(【70/105/140/175/210】+50%【法术强度】)魔法伤害，并将他们击退。吉格斯也会被震开，但不会受到伤害。 【定点爆破】会自动摧毁生命值低于【25%/27.5%/30%/32.5%/35%】的防御塔伤害",
   "icon": "assets/img/skills/Ziggsw_ZiggsW.png"
  },
  {
   "key": "e",
   "label": "E",
   "name": "海克斯爆破雷区",
   "desc": "吉格斯布下敌人一踩就炸的感应雷区，对踩中地雷的敌人造成(【30/70/110/150/190】+【25%/30%/35%/40%/50%】【法术强度】)魔法伤害和持续1.5秒的【10%/20%/30%/40%50%】的减速。地雷持续10秒。 第一个之后的地雷造成(【12/28/44/60/76】+【10%/12%/14%16%/18%】【法术强度】)伤害。",
   "icon": "assets/img/skills/Ziggse_ZiggsE.png"
  },
  {
   "key": "r",
   "label": "R",
   "name": "科学的地狱火炮",
   "desc": "吉格斯扔出他的终极造物，在爆炸范围的中心区域造成(【300/500/700】+100%【法术强度】)，或在边缘地区造成(【200/334/467】+73%【法术强度】)魔法伤害。",
   "icon": "assets/img/skills/Ziggsr_ZiggsR.png"
  }
 ],
